# Environment Configuration Template for PrimeWave Lab Resource Reservation Management System
# Copy this file to .env and configure your local PostgreSQL credentials:
# cp .env.example .env

# PostgreSQL connection string used by Prisma ORM
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/resource_reservation_db?schema=public"
